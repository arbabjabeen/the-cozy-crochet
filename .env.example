# =========================================================
# THE COZY CROCHET - ENVIRONMENT CONFIGURATION (.env.local)
# =========================================================

# --- POSTGRESQL DATABASE (For Vercel Deployment & Live Database) ---
# Supports Neon (neon.tech), Supabase, Vercel Postgres, AWS RDS, or Local PostgreSQL
# Example for Neon / Supabase:
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/cozy_crochet?sslmode=require
# Example for Local PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/cozy_crochet
DATABASE_URL=

# --- EMAIL NOTIFICATIONS (Gmail SMTP for order/newsletter emails) ---
# Store Owner Email (where notifications and confirmation copies are sent)
EMAIL_USER=arbabjabeen2006@gmail.com

# Gmail App Password:
# 1. Go to your Google Account (myaccount.google.com)
# 2. Go to Security -> 2-Step Verification -> App Passwords
# 3. Create a 16-character App Password for "The Cozy Crochet"
# 4. Paste it here:
GMAIL_APP_PASSWORD=your_16_digit_app_password_here
